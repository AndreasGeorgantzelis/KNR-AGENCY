<header class="knr-header" data-knr-header>
  <div class="knr-shell knr-header__inner">
    <a class="knr-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 280 | image_tag: class: 'knr-header__logo', loading: 'eager', alt: shop.name }}
      {%- else -%}
        <span>{{ section.settings.brand_text | default: shop.name | escape }}</span>
      {%- endif -%}
    </a>

    {%- if section.settings.use_custom_links -%}
      <nav class="knr-header__nav" aria-label="{{ section.settings.menu_label | escape }}">
        {%- if section.settings.link_1_label != blank -%}
          <a href="{{ section.settings.link_1_url | default: routes.collections_url }}" class="knr-header__nav-link">{{ section.settings.link_1_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.link_2_label != blank -%}
          <a href="{{ section.settings.link_2_url | default: routes.root_url }}" class="knr-header__nav-link">{{ section.settings.link_2_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.link_3_label != blank -%}
          <a href="{{ section.settings.link_3_url | default: routes.root_url }}" class="knr-header__nav-link">{{ section.settings.link_3_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.link_4_label != blank -%}
          <a href="{{ section.settings.link_4_url | default: routes.root_url }}" class="knr-header__nav-link">{{ section.settings.link_4_label | escape }}</a>
        {%- endif -%}
      </nav>
    {%- elsif section.settings.menu != blank -%}
      <nav class="knr-header__nav" aria-label="{{ section.settings.menu_label | escape }}">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}" class="knr-header__nav-link{% if link.active %} is-active{% endif %}">
            {{ link.title | escape }}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="knr-header__actions">
      <a class="knr-header__icon-link" href="{{ section.settings.location_url | default: routes.root_url }}" aria-label="{{ section.settings.location_label | escape }}">
        <img src="{{ 'knr-icon-location.png' | asset_url }}" alt="" width="16" height="16" loading="eager">
      </a>
      <a class="knr-header__icon-link" href="{{ routes.account_url }}" aria-label="{{ 'customer.account.title' | t }}">
        <img src="{{ 'knr-icon-user.png' | asset_url }}" alt="" width="18" height="18" loading="eager">
      </a>
      <a class="knr-header__icon-link" href="{{ routes.search_url }}" aria-label="{{ 'general.search.search' | t }}">
        <img src="{{ 'knr-icon-search.png' | asset_url }}" alt="" width="16" height="16" loading="eager">
      </a>
      <a class="knr-header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'templates.cart.cart' | t }}">
        <img src="{{ 'knr-icon-bag.png' | asset_url }}" alt="" width="16" height="16" loading="eager">
        <span class="visually-hidden">{{ section.settings.cart_label | default: 'Cart' | escape }}</span>
        <span class="knr-cart-count" data-knr-cart-count aria-live="polite">{{ cart.item_count }}</span>
      </a>
      {%- if section.settings.use_custom_links -%}
        <details class="knr-header__mobile-menu">
          <summary aria-label="{{ section.settings.menu_label | escape }}">
            <span></span>
            <span></span>
          </summary>
          <nav class="knr-header__drawer" aria-label="{{ section.settings.menu_label | escape }}">
            {%- if section.settings.link_1_label != blank -%}
              <a href="{{ section.settings.link_1_url | default: routes.collections_url }}">{{ section.settings.link_1_label | escape }}</a>
            {%- endif -%}
            {%- if section.settings.link_2_label != blank -%}
              <a href="{{ section.settings.link_2_url | default: routes.root_url }}">{{ section.settings.link_2_label | escape }}</a>
            {%- endif -%}
            {%- if section.settings.link_3_label != blank -%}
              <a href="{{ section.settings.link_3_url | default: routes.root_url }}">{{ section.settings.link_3_label | escape }}</a>
            {%- endif -%}
            {%- if section.settings.link_4_label != blank -%}
              <a href="{{ section.settings.link_4_url | default: routes.root_url }}">{{ section.settings.link_4_label | escape }}</a>
            {%- endif -%}
          </nav>
        </details>
      {%- elsif section.settings.menu != blank -%}
        <details class="knr-header__mobile-menu">
          <summary aria-label="{{ section.settings.menu_label | escape }}">
            <span></span>
            <span></span>
          </summary>
          <nav class="knr-header__drawer" aria-label="{{ section.settings.menu_label | escape }}">
            {%- for link in section.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
            {%- endfor -%}
          </nav>
        </details>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "KNR header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "Maison Celestine"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "use_custom_links",
      "label": "Use custom links",
      "default": false
    },
    {
      "type": "text",
      "id": "link_1_label",
      "label": "Link 1 label",
      "default": "Produits"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "link_2_label",
      "label": "Link 2 label",
      "default": "Diagnostique"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "text",
      "id": "link_3_label",
      "label": "Link 3 label",
      "default": "La marque"
    },
    {
      "type": "url",
      "id": "link_3_url",
      "label": "Link 3 URL"
    },
    {
      "type": "text",
      "id": "link_4_label",
      "label": "Link 4 label",
      "default": "Journal"
    },
    {
      "type": "url",
      "id": "link_4_url",
      "label": "Link 4 URL"
    },
    {
      "type": "text",
      "id": "menu_label",
      "label": "Menu accessible label",
      "default": "Main menu"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart label",
      "default": "Cart"
    },
    {
      "type": "text",
      "id": "location_label",
      "label": "Location accessible label",
      "default": "Store location"
    },
    {
      "type": "url",
      "id": "location_url",
      "label": "Location URL"
    }
  ],
  "presets": [
    {
      "name": "KNR header"
    }
  ]
}
{% endschema %}
