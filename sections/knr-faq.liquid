<section class="knr-faq" data-knr-faq>
  <div class="knr-shell knr-faq__inner">
    <div class="knr-section-heading">
      {%- if section.settings.eyebrow != blank -%}
        <p class="knr-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="knr-faq__list">
        {%- for block in section.blocks -%}
          <div class="knr-faq__item" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="knr-faq__question"
              aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="KnrFaqPanel-{{ block.id }}"
              data-knr-faq-trigger
            >
              <span>{{ block.settings.question | escape }}</span>
              <span aria-hidden="true">+</span>
            </button>
            <div
              id="KnrFaqPanel-{{ block.id }}"
              class="knr-faq__answer rte"
              {% unless forloop.first %}hidden{% endunless %}
              data-knr-faq-panel
            >
              {{ block.settings.answer }}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "KNR FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How should I use this product?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>FAQ answers are editable blocks in the Shopify theme editor.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KNR FAQ"
    }
  ]
}
{% endschema %}
