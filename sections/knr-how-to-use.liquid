<section class="knr-how-to-use">
  <div class="knr-shell">
    <div class="knr-section-heading">
      {%- if section.settings.eyebrow != blank -%}
        <p class="knr-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="knr-how-to-use__grid">
        {%- for block in section.blocks -%}
          <article class="knr-how-to-use__step" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 520 | image_tag: loading: 'lazy', class: 'knr-how-to-use__image', alt: block.settings.title }}
            {%- endif -%}
            <span>{{ block.settings.step | escape }}</span>
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "KNR how to use",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to use"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "step",
          "label": "Step",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Prepare"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Add editable application guidance from the theme editor."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KNR how to use"
    }
  ]
}
{% endschema %}
