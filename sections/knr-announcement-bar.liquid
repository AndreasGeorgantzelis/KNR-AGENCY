{%- if section.settings.text != blank -%}
  <aside class="knr-announcement" aria-label="{{ section.settings.aria_label | escape }}">
    <div class="knr-shell knr-announcement__inner">
      <p>{{ section.settings.text | escape }}</p>
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="knr-announcement__link">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "KNR announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible label",
      "default": "Announcement"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Complimentary delivery on orders over 75 EUR"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop now"
    }
  ],
  "presets": [
    {
      "name": "KNR announcement bar"
    }
  ]
}
{% endschema %}
